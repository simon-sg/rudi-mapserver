# Chemin vers le repertoire de medias de votre noeud (suppose un
# rudi-node-container clone juste a cote, comme ce depot).
RUDI_NODE_MEDIA_DIR=../rudi-node-container/source-media

# Ports standards d'un deploiement rudi-node-container (catalog 3030,
# manager 3032 -- voir ses propres fichiers docker-compose*.yml). Si vous
# ciblez un autre type d'installation (ex. un harnais de developpement avec
# des ports differents), ajustez ces deux valeurs en consequence.
RUDI_CATALOG_HOST=host.docker.internal
RUDI_CATALOG_PORT=3030
RUDI_MANAGER_HOST=host.docker.internal
RUDI_MANAGER_PORT=3032

# Identifiants d'un compte habilite sur le noeud (pour declare_services.py).
RUDI_USER=admin
RUDI_PASSWORD=admin

# URL publique de base de vos propres flux WMS/WFS/OGC API Features, telle
# qu'ecrite dans le catalogue -- a adapter vers votre domaine en production.
RUDI_GEO_PUBLIC_BASE=https://localhost:8444
